# Copy this file to ".env" ON THE SERVER ONLY and fill in real values.
# ".env" is in .gitignore — it is never pushed to GitHub. Never put real values in THIS file.

# 0 = production (required on a server). 1 = local computer.
DJANGO_DEBUG=0

# A new random key, at least 40 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Your domain(s), comma separated, e.g. bakehisab.com,www.bakehisab.com
DJANGO_ALLOWED_HOSTS=

# Same domains with https://, e.g. https://bakehisab.com
DJANGO_CSRF_TRUSTED_ORIGINS=
